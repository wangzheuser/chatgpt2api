{
  "_comment": "自动注册邮箱渠道示例配置。复制为 data/register.json 后由后台注册页读取；也可直接在 Web 注册页配置。以下为本地实测均可创建邮箱的零配置临时邮箱渠道，mail.providers 里多个 enable=true 的渠道注册时会自动轮询(无需手动逐个切换)。",
  "_note_domain": "临时邮箱域名可能被 OpenAI 动态封禁(报 account_creation_failed / unsupported_email)，某天能注册的域名过几天可能失效。启用多个渠道轮询可提高成功率。dropmail 的 domain 列的是曾实测可注册的域名(会变)，其余渠道留空用服务默认域名。",
  "proxy": "http://127.0.0.1:7890",
  "total": 10,
  "threads": 3,
  "mail": {
    "request_timeout": 30,
    "wait_timeout": 120,
    "wait_interval": 3,
    "api_use_register_proxy": true,
    "providers": [
      { "type": "dropmail", "enable": true, "domain": ["mail2me.co", "pickmemail.com", "maximail.vip", "mailtowin.com", "pickmail.org"] },
      { "type": "openinbox", "enable": true, "domain": [] },
      { "type": "mailtm", "enable": true, "domain": [] },
      { "type": "guerrillamail", "enable": true, "domain": [] },
      { "type": "tempmailplus", "enable": true, "domain": [] },
      { "type": "freecustom", "enable": true, "domain": [] },
      { "type": "inboxkitten", "enable": true, "domain": [] },
      { "type": "emailnator", "enable": true, "domain": [] }
    ]
  }
}
